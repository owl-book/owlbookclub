# Supabase 대시보드 > Project Settings > API 에서 복사
SUPABASE_URL=https://xxxx.supabase.co
# service_role 키: 서버에서만 사용. 절대 NEXT_PUBLIC_ 을 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 배포 주소 (공유 미리보기용)
NEXT_PUBLIC_SITE_URL=https://owlbookclub.vercel.app

# 관리자 신고함(/admin/reports) 비밀번호. 16자 이상이어야 켜진다(짧거나 없으면 신고함 주소 자체가 '없는 페이지'로 보임)
# 터미널에서 `openssl rand -base64 24` 결과를 붙여 넣기. 바꾸면 이미 들어가 있던 기기는 모두 자동으로 나가진다
ADMIN_PASSWORD=

NEXT_PUBLIC_CONTACT_EMAIL=

# 알라딘 TTB 키(책 표지). https://www.aladin.co.kr/ttb/wblog_manage.aspx 에서 무료 발급. 없으면 표지 자리에 대체 디자인이 보임
ALADIN_TTB_KEY=

# ── 간편 로그인 ──
# 로그인 쿠키 서명용 비밀값. 터미널에서 `openssl rand -base64 32` 결과를 붙여 넣기. 없으면 로그인 기능 전체가 숨겨짐
AUTH_SECRET=
# 각 회사 개발자 콘솔에 '리다이렉트(콜백) 주소'로 아래를 등록:
#   https://owlbookclub.vercel.app/auth/{kakao|naver|google}/callback
#   http://localhost:3000/auth/{kakao|naver|google}/callback   (내 컴퓨터 테스트용)
# 키가 있는 로그인만 버튼이 보인다
# 카카오: https://developers.kakao.com > 내 애플리케이션 > 앱 키 'REST API 키'. 동의항목은 '닉네임'만
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 네이버: https://developers.naver.com/apps > 애플리케이션 등록(네이버 로그인). 제공 정보는 '별명'만
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글: https://console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
